{
  "name": "angel-agent-os",
  "version": "1.104.2",
  "description": "A Feishu-driven local AgentOS that coordinates role-based Codex development workflows.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/angelaboy0113/agentos.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start:local": "node src/control-plane/local.js",
    "start:control": "node src/control-plane/server.js",
    "start:runner": "node src/runner/index.js",
    "test": "node scripts/test.js",
    "check": "node --check src/control-plane/server.js && node --check src/control-plane/local.js && node --check src/control-plane/lark-event-source.js && node --check src/runner/index.js && node scripts/test.js",
    "check:instance": "sh scripts/run-system-instance.sh --check",
    "start:instance": "sh scripts/run-system-instance.sh --start"
  },
  "dependencies": {
    "docx": "9.15.3",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "mongodb": "5.9.2",
    "mysql2": "3.24.4",
    "playwright": "1.63.0",
    "pptxgenjs": "4.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.1.0"
    }
  }
}
