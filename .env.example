# Control plane
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8787
AGENTOS_PUBLIC_URL=https://agentos.example.com
AGENTOS_DATA_DIR=./data
AGENTOS_ADMIN_TOKEN=replace-with-a-long-random-value
AGENTOS_RUNNER_TOKEN=replace-with-a-different-long-random-value
AGENTOS_PROJECTS_FILE=./config/projects.local.json

# Feishu application. Leave empty for local mock testing.
FEISHU_TRANSPORT=lark-cli
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
LARK_CLI_ENTRY=

# Local runner
AGENTOS_SERVER_URL=http://127.0.0.1:8787
AGENTOS_RUNNER_ID=dev-windows-01
AGENTOS_RUNNER_CONCURRENCY=3
AGENTOS_ANALYSIS_TURN_TIMEOUT_MS=900000
AGENTOS_ANALYSIS_RESUME_TIMEOUT_MS=480000
AGENTOS_ENV_INVESTIGATION_MAX_CALLS=24
AGENTOS_ENV_INVESTIGATION_MAX_MS=150000
AGENTOS_RUNNER_POLL_MS=3000
AGENTOS_RUNNER_WORKTREE_ROOT=./data/worktrees
AGENTOS_RUNNER_EXECUTOR=mock
CODEX_BIN=codex
