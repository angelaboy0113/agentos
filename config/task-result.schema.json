{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "finalMessage",
    "handoff",
    "environmentQuery",
    "websiteQuery",
    "investigation",
    "environmentSetup"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ready",
        "needs_clarification",
        "blocked",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "finalMessage": {
      "type": "string"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "checks",
        "risks",
        "returnTo"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "prd",
                  "spec",
                  "code",
                  "test",
                  "report",
                  "decision"
                ]
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "status",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "not_applicable"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string"
          }
        },
        "returnTo": {
          "type": "string",
          "enum": [
            "none",
            "owner",
            "pm",
            "developer",
            "qa",
            "auditor"
          ]
        }
      }
    },
    "environmentQuery": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environmentId",
            "queryId",
            "parameters",
            "goalIds"
          ],
          "properties": {
            "environmentId": {
              "type": "string"
            },
            "queryId": {
              "type": "string"
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "goalIds": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "websiteQuery": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "tier",
            "purpose"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "tier": {
              "type": "string",
              "enum": [
                "uat",
                "prd"
              ]
            },
            "purpose": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      ]
    },
    "investigation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "goals",
            "attempts",
            "nextStep",
            "blocker",
            "causalAssessment"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "continue",
                "wait"
              ]
            },
            "goals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "required",
                  "status",
                  "evidence"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "verified",
                      "open"
                    ]
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              }
            },
            "attempts": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string"
              }
            },
            "nextStep": {
              "type": "string"
            },
            "causalAssessment": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "link",
                    "mechanism",
                    "evidence",
                    "alternatives"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unknown",
                        "highly_supported",
                        "confirmed"
                      ]
                    },
                    "link": {
                      "type": "string",
                      "enum": [
                        "unproven",
                        "direct",
                        "reproduced",
                        "multi_evidence"
                      ]
                    },
                    "mechanism": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "array",
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reference",
                          "finding"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "business_error",
                              "application_log",
                              "runtime_trace",
                              "database",
                              "source",
                              "comparison",
                              "calculation",
                              "web_runtime",
                              "gateway_response",
                              "screenshot",
                              "other"
                            ]
                          },
                          "reference": {
                            "type": "string"
                          },
                          "finding": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "alternatives": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "blocker": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "needed",
                    "evidence"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "login",
                        "approval",
                        "user_input",
                        "unavailable"
                      ]
                    },
                    "needed": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "environmentSetup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tier",
            "url"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "nacos",
                "mysql"
              ]
            },
            "tier": {
              "type": "string",
              "enum": [
                "uat",
                "prd"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
