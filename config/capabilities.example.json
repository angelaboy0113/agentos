{
  "description": "工具参数示例；不是私有连接配置，不可直接充当真实数据/发布证明",
  "period_dataset": {
    "populationRef": "REPLACE_WITH_COMPLETE_DATASET_REF",
    "keyColumns": [
      "object_id"
    ],
    "period": {
      "unit": "month",
      "start": "2025-12",
      "end": "2026-02",
      "column": "period"
    },
    "sources": [
      {
        "datasetRef": "REPLACE_WITH_COMPLETE_SOURCE_REF",
        "keyColumns": [
          "object_id"
        ],
        "periodColumn": "month",
        "duplicates": "error",
        "outside": "error",
        "metrics": [
          {
            "column": "amount",
            "as": "current_amount",
            "cumulativeAs": "running_amount",
            "statusAs": "amount_status",
            "missing": "error",
            "nulls": "error"
          }
        ]
      }
    ]
  },
  "deployment_evidence": {
    "datasetRef": "REPLACE_WITH_AUTHORIZED_RELEASE_DATASET_REF",
    "application": "REPLACE_WITH_VERIFIED_APP_ID",
    "columns": {
      "system": "system_id",
      "environment": "environment_id",
      "application": "application_id",
      "deployedAt": "deployment_time_with_offset",
      "status": "release_status",
      "commit": "git_commit"
    },
    "successValues": [
      "REPLACE_WITH_VERIFIED_SUCCESS_VALUE"
    ],
    "evidence": "REPLACE_WITH_REAL_RELEASE_SOURCE_AND_FIELD_SEMANTICS"
  },
  "transform_dataset": {
    "datasetRef": "REPLACE_WITH_COMPLETE_DATASET_REF",
    "keyColumn": "object_id",
    "scopeEvidence": "REPLACE_WITH_VERIFIED_SCOPE_RULE",
    "filters": [
      {
        "column": "category",
        "op": "in",
        "values": [
          "REPLACE_WITH_VERIFIED_CATEGORY"
        ]
      }
    ],
    "hierarchy": {
      "parentColumn": "parent_id",
      "rootIds": [
        "REPLACE_WITH_VERIFIED_ROOT_ID"
      ],
      "includeRoots": false,
      "nodeFilters": [],
      "pathColumns": [
        {
          "column": "name",
          "as": "full_path"
        }
      ],
      "separator": " / "
    }
  },
  "period_statistics": {
    "populationRef": "REPLACE_WITH_COMPLETE_OBJECT_DATASET_REF",
    "keyColumns": [
      "object_id"
    ],
    "period": {
      "unit": "month",
      "start": "2025-12",
      "end": "2026-05",
      "column": "period"
    },
    "sources": [
      {
        "datasetRef": "REPLACE_WITH_COMPLETE_EVENT_DATASET_REF",
        "keyColumns": [
          "object_id"
        ],
        "periodColumn": "event_day",
        "periodUnit": "day",
        "duplicates": "sum",
        "outside": "error",
        "metrics": [
          {
            "op": "count",
            "as": "events",
            "missing": "zero",
            "nulls": "error"
          },
          {
            "op": "count_distinct",
            "column": "member_id",
            "as": "members",
            "cumulativeAs": "window_unique_members",
            "missing": "zero",
            "nulls": "error"
          }
        ]
      }
    ]
  },
  "inspect_dataset": {
    "datasetRef": "REPLACE_WITH_SAVED_DATASET_REF",
    "offset": 0,
    "limit": 20,
    "columns": [
      "object_id",
      "period"
    ]
  },
  "list_datasets": {
    "kind": "report_draft",
    "offset": 0,
    "limit": 20
  },
  "list_tool_results": {
    "offset": 0,
    "limit": 20
  },
  "read_tool_result": {
    "resultRef": "REPLACE_WITH_CURRENT_JOB_RESULT_REF",
    "offset": 0,
    "limit": 4000
  },
  "window_dataset": {
    "populationRef": "REPLACE_WITH_COMPLETE_POPULATION_REF",
    "populationKeys": [
      "owner_id",
      "object_id"
    ],
    "groupColumns": [
      "owner_id"
    ],
    "timeType": "instant",
    "windows": [
      {
        "start": "2026-01-01T00:00:00+00:00",
        "end": "2026-02-01T00:00:00+00:00",
        "countColumn": "objects_jan",
        "percentageColumn": "coverage_jan",
        "precision": 2
      }
    ],
    "sources": [
      {
        "datasetRef": "REPLACE_WITH_COMPLETE_EVENTS_REF",
        "populationKeys": [
          "owner_id",
          "object_id"
        ],
        "timeColumn": "event_time",
        "outsidePopulation": "error"
      }
    ]
  }
}
