{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply",
    "action",
    "intent",
    "instruction",
    "jobId",
    "projectId",
    "attachmentIds",
    "requiresSourceInspection",
    "environmentQuery",
    "environmentSetup",
    "sourceEnvironment",
    "knowledgeMatch",
    "contactLookup",
    "requiresTabularDelivery"
  ],
  "properties": {
    "requiresSourceInspection": {
      "type": "boolean",
      "description": "用户要检查当前文件、源码或接口实现时为 true；问候、讨论、解释旧报告为 false。不要因旧任务缺源码而拒绝新调查。"
    },
    "reply": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "reply",
        "create_task",
        "clarify",
        "approve",
        "cancel",
        "bind_project",
        "approve_environment",
        "request_environment_setup",
        "approve_environment_setup",
        "approve_environment_without_tls",
        "lookup_contact"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "none",
        "implementation",
        "planning",
        "analysis",
        "verification",
        "audit"
      ]
    },
    "instruction": {
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "attachmentIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environmentQuery": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environmentId",
            "queryId",
            "parameters"
          ],
          "properties": {
            "environmentId": {
              "type": "string"
            },
            "queryId": {
              "type": "string"
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "environmentSetup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tier",
            "url"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "nacos",
                "mysql"
              ]
            },
            "tier": {
              "type": "string",
              "enum": [
                "uat",
                "prd"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        }
      ]
    },
    "sourceEnvironment": {
      "type": "string",
      "description": "源码分析选择 project.sourceEnvironments 中的 id；无环境或非源码任务用空字符串。环境不明且无默认值先询问，禁止猜测分支或路径。"
    },
    "knowledgeMatch": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sameIntent",
            "currentData",
            "correction",
            "roleIndependent",
            "environment",
            "attachmentReview"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "sameIntent": {
              "type": "boolean"
            },
            "currentData": {
              "type": "boolean"
            },
            "correction": {
              "type": "boolean"
            },
            "roleIndependent": {
              "type": "boolean"
            },
            "environment": {
              "type": "string"
            },
            "attachmentReview": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reviewedIds",
                    "impact",
                    "reason"
                  ],
                  "properties": {
                    "reviewedIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "impact": {
                      "type": "string",
                      "enum": [
                        "context_only",
                        "requires_live",
                        "different_scope",
                        "uncertain"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "contactLookup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "query",
            "candidateId"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "name",
                "employee_no"
              ]
            },
            "query": {
              "type": "string"
            },
            "candidateId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "requiresTabularDelivery": {
      "type": "boolean",
      "description": "多对象、多指标、清单或可复用统计结果默认需要表格文件，即使用户未写Excel/导出；纯解释讨论false。不代替环境与数据权限判断。"
    }
  }
}
