{
  "version": 1,
  "environments": {
    "sample_test_web": {
      "projectId": "sample",
      "tier": "uat",
      "kind": "website",
      "applicationRoot": true,
      "baseUrl": "https://integration.example.invalid/admin",
      "credentialRef": "sample-test-web",
      "membersRead": true,
      "ownerOpenIdsByProfile": {
        "sample-bot": [
          "ou_REPLACEOWNER"
        ]
      },
      "queries": {
        "investigate": {
          "mode": "investigate",
          "reviewed": true,
          "description": "Read approved interface mappings and logs only; no test, replay, publish or changes",
          "maxRows": 20,
          "timeoutMs": 10000,
          "browser": true,
          "parameters": [
            {
              "name": "purpose",
              "type": "string",
              "maxLength": 200
            }
          ],
          "readEndpoints": [
            {
              "method": "GET",
              "path": "/api/resources/listByFilters",
              "reviewed": true,
              "queryParameters": {
                "enable": [
                  "0",
                  "1"
                ]
              }
            },
            {
              "method": "POST",
              "path": "/api/session/context",
              "reviewed": true
            }
          ],
          "readNavigationSelectors": [
            ".application-card"
          ],
          "staticResources": [
            "https://assets.example.invalid/static/framework.js"
          ]
        }
      }
    }
  }
}
