{
  "version": 1,
  "environments": {
    "sample_test_web": {
      "projectId": "sample",
      "tier": "uat",
      "kind": "website",
      "applicationRoot": true,
      "baseUrl": "https://integration.example.invalid/admin",
      "credentialRef": "sample-test-web",
      "membersRead": true,
      "ownerOpenIdsByProfile": {
        "sample-bot": [
          "ou_REPLACEOWNER"
        ]
      },
      "queries": {
        "investigate": {
          "mode": "investigate",
          "reviewed": true,
          "description": "Read approved interface mappings and logs only; no test, replay, publish or changes",
          "maxRows": 20,
          "timeoutMs": 10000,
          "browser": true,
          "parameters": [
            {
              "name": "purpose",
              "type": "string"
            }
          ],
          "readEndpoints": [
            {
              "method": "GET",
              "path": "/api/resources/listByFilters",
              "reviewed": true,
              "queryParameters": {
                "enable": [
                  "0",
                  "1"
                ]
              }
            },
            {
              "method": "POST",
              "path": "/api/session/context",
              "reviewed": true
            },
            {
              "method": "POST",
              "path": "/api/referenceOptions",
              "reviewed": true
            },
            {
              "method": "POST",
              "path": "/api/resources/list/v2",
              "reviewed": true
            }
          ],
          "readNavigationSelectors": [
            ".application-card"
          ],
          "staticResources": [
            "https://assets.example.invalid/static/framework.js"
          ],
          "staticResourceRoots": [
            "https://assets.example.invalid/releases/build42/static/"
          ],
          "loginReads": [
            {
              "origin": "https://identity.example.invalid",
              "path": "/connect/qrconnect",
              "types": [
                "document"
              ]
            },
            {
              "origin": "https://identity.example.invalid",
              "path": "/qrcode/",
              "types": [
                "image"
              ]
            }
          ]
        }
      },
      "loginNavigation": {
        "interactive": true,
        "steps": [
          "\u626b\u7801\u767b\u5f55"
        ]
      }
    }
  }
}
