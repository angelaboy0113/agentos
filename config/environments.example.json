{
  "version": 1,
  "environments": {
    "prd_mysql": {
      "projectId": "your_project",
      "tier": "prd",
      "kind": "mysql",
      "host": "db.example.internal",
      "port": 3306,
      "database": "your_database",
      "tls": true,
      "credentialRef": "prd_mysql_readonly",
      "membersRead": false,
      "ownerOpenIdsByProfile": {
        "agentos-owner": [
          "ou_REPLACEWITHENVOWNER"
        ]
      },
      "queries": {
        "connection_check": {
          "reviewed": true,
          "description": "核对当前库名和数据库时间",
          "sql": "SELECT DATABASE() AS database_name, CURRENT_TIMESTAMP() AS checked_at",
          "parameters": [],
          "outputColumns": [
            "database_name",
            "checked_at"
          ],
          "maxRows": 1,
          "timeoutMs": 5000
        }
      }
    },
    "example_pr_reads": {
      "kind": "cnb",
      "projectId": "your-project",
      "tier": "uat",
      "credentialRef": "your-pr-read",
      "membersRead": true,
      "ownerOpenIdsByProfile": {
        "your-bot": [
          "ou_your_admin"
        ]
      },
      "cnb": {
        "apiOrigin": "https://api.cnb.cool",
        "resources": [
          "pull-requests"
        ]
      },
      "queries": {
        "investigate": {
          "mode": "investigate",
          "reviewed": true,
          "description": "Read platform PR operators and close times; not deployment evidence",
          "parameters": [
            {
              "name": "purpose",
              "type": "string"
            }
          ],
          "repositories": [
            "your-org/your-project/your-repository"
          ],
          "maxRows": 100,
          "timeoutMs": 600000
        }
      }
    }
  },
  "executionPolicy": {
    "mysqlQueryTimeoutMs": 600000
  }
}
